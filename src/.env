DB_HOST=localhost
DB_PORT=3306
DB_USER=moocs_user
DB_PASSWORD=123456789
DB_NAME=moocs_db

# Spark Configuration
SPARK_APP_NAME=MOOCs-Aggregator-Spark
SPARK_MASTER=local[*]
SPARK_OUTPUT_DIR=./spark_output
SPARK_CHECKPOINT_DIR=./spark_checkpoint
MIN_TF_IDF_FEATURES=100
NUM_CLUSTERS=10
SIMILARITY_THRESHOLD=0.3
TOP_N_SIMILAR_COURSES=5
# Coursera
COURSERA_MODE=scrape
COURSERA_SITEMAP_INDEX=https://www.coursera.org/sitemap.xml
COURSERA_COURSE_SITEMAP=https://www.coursera.org/sitemap~www~courses.xml
COURSERA_MAX_URLS=30

#MIT 
MIT_OCW_MODE=scrape
MIT_OCW_SITEMAP_INDEX=https://ocw.mit.edu/sitemap.xml
MIT_OCW_SITEMAPS=https://ocw.mit.edu/sitemap-www.xml
MIT_OCW_MAX_URLS=30

# HTTP politeness
HTTP_TIMEOUT_S=30
HTTP_SLEEP_MS=200
HTTP_MAX_RETRIES=5

# Optional (if later needed)
UDEMY_CLIENT_ID=
UDEMY_CLIENT_SECRET=
COURSERA_AUTH_TOKEN=
